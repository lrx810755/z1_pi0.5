# Repository and external runtime locations
Z1_SMOLVLA_ROOT=/path/to/z1-smolvla
Z1_ASSET_ROOT=/path/to/z1-smolvla/isaac_assets/z1
Z1_ROS_WS=/path/to/z1-smolvla/ros2_ws
SMOLVLA_DATA_ROOT=/path/to/z1-smolvla/data/runtime
ISAAC_SIM_ROOT=/path/to/isaac-sim

# ROS 2 runtime
ROS_DISTRO=humble
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Optional real-arm dependencies
Z1_REAL_ARM_CONTROLLER_DIR=/path/to/unitree_z1/z1_controller
Z1_REAL_ARM_SDK_DIR=/path/to/unitree_z1/z1_sdk

