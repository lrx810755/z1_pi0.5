<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- RGB messages are 691200 to 921600 bytes. The default 512 KiB SHM
       segment can lose fragments even on localhost. Reserve room for
       concurrent images; retain UDP for discovery and remote ROS peers. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>z1_camera_shm</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>z1_discovery_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="z1_camera_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>z1_camera_shm</transport_id>
        <transport_id>z1_discovery_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
